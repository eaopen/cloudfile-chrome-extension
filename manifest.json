{
  "manifest_version": 3,
  "key": "",
  "name": "CloudFile Local Session Receiver",
  "description": "Passes downloaded CloudFile session files to the signed local agent.",
  "version": "0.5.0",
  "action": {
    "default_title": "CloudFile Local",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "background.js" },
  "externally_connectable": {
    "matches": [
      "http://10.9.8.162:6111/*",
      "http://10.12.1.157:8092/*",
      "http://etech.stcetech.ad01.sec.com/*"
    ]
  },
  "permissions": ["downloads", "nativeMessaging", "storage", "activeTab", "alarms"]
}
